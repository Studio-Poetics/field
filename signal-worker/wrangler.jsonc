{
	"name": "field-pair-signal",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOM",
				"class_name": "PairingRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PairingRoom"]
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
